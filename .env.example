# Secrets are read from the environment at call time ONLY.
# This file contains NAMES only. Copy to `.env` and fill values locally.
# `.env` is gitignored and must never be committed.

# HMAC key used to sign grants. If unset, Actenon-Permit looks for a persisted
# dev key (see ACTENON_SIGNING_KEY_FILE below), then falls back to an ephemeral
# per-process key + warning. Set this to a stable value in production.
ACTENON_SIGNING_KEY=

# Path to a persisted dev signing key. Created by `permit init-key`. If set
# (or if the default ~/.actenon-permit/signing-key exists), grants validate
# across process restarts — essential for multi-terminal workflows like
# `permit issue` in one shell and `permit serve` in another.
ACTENON_SIGNING_KEY_FILE=

# Mock provider secret used by the demo. NEVER a real key. The agent never
# sees this value — it lives only inside the broker.
MOCK_STRIPE_KEY=sk_mock_123

# Path to the local SQLite database used for state + ledger. Defaults to
# ./actenon.db in the current working directory.
ACTENON_DB_PATH=actenon.db

# Control plane bind address (localhost only in v0).
ACTENON_HOST=127.0.0.1
ACTENON_PORT=7780
