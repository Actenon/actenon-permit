# Secrets are read from the environment at call time ONLY.
# This file contains NAMES only. Copy to `.env` and fill values locally.
# `.env` is gitignored and must never be committed.

# HMAC key used to sign grants. If unset, Actenon-Permit generates a dev key
# and prints a warning. Set this to a stable value in production.
ACTENON_SIGNING_KEY=

# Mock provider secret used by the demo. NEVER a real key. The agent never
# sees this value — it lives only inside the broker.
MOCK_STRIPE_KEY=sk_mock_123

# Path to the local SQLite database used for state + ledger. Defaults to
# ./actenon.db in the current working directory.
ACTENON_DB_PATH=actenon.db

# Control plane bind address (localhost only in v0).
ACTENON_HOST=127.0.0.1
ACTENON_PORT=7780
